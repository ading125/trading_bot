# Non-secret host configuration only. Never put provider credentials here.
INVESTING_BOT_HOST_PORT=8000
# The default monitored CivicTracker executive. Polling is never enabled in tests.
INVESTING_BOT_CIVICTRACKER_MEMBER_UUID=3094abf7-4a95-4b8d-8c8d-af7d1c3747a1
INVESTING_BOT_CIVICTRACKER_POLL_SECONDS=900
INVESTING_BOT_CIVICTRACKER_PAGE_SIZE=20
INVESTING_BOT_CIVICTRACKER_MAX_PAGES=5
INVESTING_BOT_CIVICTRACKER_COLLECTION_ENABLED=true
# Market collection is opt-in until a universe/strategy schedule is configured.
INVESTING_BOT_MARKET_COLLECTION_ENABLED=false
INVESTING_BOT_MARKET_POLL_SECONDS=3600
INVESTING_BOT_MARKET_SEED_SYMBOLS=SPY,AAPL,MSFT,CVX
INVESTING_BOT_YAHOO_REPAIR_ENABLED=false
# Candidate refresh uses stored source data and does not call an LLM.
INVESTING_BOT_CANDIDATE_REFRESH_ENABLED=true
INVESTING_BOT_CANDIDATE_REFRESH_SECONDS=900
# Groq is selected when the credential vault is explicitly unlocked; otherwise analysis falls back to the recorded provider.
INVESTING_BOT_ANALYSIS_REFRESH_ENABLED=true
INVESTING_BOT_ANALYSIS_REFRESH_SECONDS=3600
INVESTING_BOT_ANALYSIS_SEED_SYMBOLS=CVX
INVESTING_BOT_GROQ_TIMEOUT_SECONDS=60
INVESTING_BOT_GROQ_RETRIES=2
# Deterministic strategy hypotheses evaluate stored data only; they do not call APIs.
INVESTING_BOT_STRATEGY_REFRESH_ENABLED=true
INVESTING_BOT_STRATEGY_REFRESH_SECONDS=900
INVESTING_BOT_STRATEGY_SEED_SYMBOLS=CVX
